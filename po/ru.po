msgid "Theme file (.theme) or name"
msgstr "Файл темы (.theme) или название"

#: ../Onboard/Config.py:249
msgid "Window size, widthxheight"
msgstr "Размер окна, ширина × высота"

#: ../Onboard/Config.py:250
msgid "Window x position"
msgstr "Положение окна по горизонтали"

#: ../Onboard/Config.py:251
msgid "Window y position"
msgstr "Положение окна по вертикали"

