<?xml version="1.0" ?>

<!--
Windows 11 Touch Keyboard Theme for Onboard
Based on the Windows 11 on-screen keyboard design language.
-->

<theme format="1.3" name="Windows11">
  <color_scheme>Windows11 Dark</color_scheme>
  <background_gradient>0.0</background_gradient>
  <key_style>flat</key_style>
  <roundrect_radius>30.0</roundrect_radius>
  <key_size>92.0</key_size>
  <key_stroke_width>0.0</key_stroke_width>
  <key_fill_gradient>5.0</key_fill_gradient>
  <key_stroke_gradient>0.0</key_stroke_gradient>
  <key_gradient_direction>0.0</key_gradient_direction>
  <key_label_font>Segoe UI</key_label_font>
  <key_label_overrides/>
  <key_shadow_strength>15.0</key_shadow_strength>
  <key_shadow_size>10.0</key_shadow_size>
</theme>
