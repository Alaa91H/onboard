<?xml version="1.0" ?>

<!--
Gboard Theme for Onboard
Based on Google Gboard / Material Design 3 design language.
Features: Rounded keys, Material You colors, clean typography, subtle elevation.
-->

<theme format="1.3" name="Gboard">
  <color_scheme>Gboard Dark</color_scheme>
  <background_gradient>0.0</background_gradient>
  <key_style>flat</key_style>
  <roundrect_radius>45.0</roundrect_radius>
  <key_size>94.0</key_size>
  <key_stroke_width>0.0</key_stroke_width>
  <key_fill_gradient>2.0</key_fill_gradient>
  <key_stroke_gradient>0.0</key_stroke_gradient>
  <key_gradient_direction>0.0</key_gradient_direction>
  <key_label_font>Google Sans</key_label_font>
  <key_label_overrides/>
  <key_shadow_strength>8.0</key_shadow_strength>
  <key_shadow_size>6.0</key_shadow_size>
</theme>
