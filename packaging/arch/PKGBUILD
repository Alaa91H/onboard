# Maintainer release template for Arch Linux and derivatives.
# Place onboard-1.4.4.tar.gz in this directory or replace source= with the
# immutable release URL and a real b2 checksum before publication.

pkgname=onboard
pkgver=1.4.4
pkgrel=6
pkgdesc='On-screen keyboard for Linux desktops'
arch=('x86_64' 'aarch64')
url='https://github.com/Alaa91H/onboard'
license=('GPL-3.0-or-later')
depends=(
  'dconf'
  'gtk3'
  'hunspell'
  'iso-codes'
  'libcanberra'
  'libxkbfile'
  'python'
  'python-cairo'
  'python-dbus'
  'python-gobject'
  'xorg-libx11'
  'xorg-libxi'
  'xorg-libxtst'
)
makedepends=(
  'gettext'
  'intltool'
  'rust'
  'pkgconf'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
optdepends=(
  'gtk-layer-shell: native floating keyboard surfaces on compatible Wayland compositors'
  'at-spi2-core: direct text insertion and accessibility integration'
)
source=("${pkgname}-${pkgver}.tar.gz")
b2sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${pkgname}-${pkgver}"
  python -m unittest \
    Onboard.test.test_ClipboardHistory \
    Onboard.test.test_InputSources \
    Onboard.test.test_LayoutLoaderSVG \
    Onboard.test.test_NativeInput \
    Onboard.test.test_ArabicLocalization \
    Onboard.test.test_RTL
}

package() {
  cd "${pkgname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 build/desktop/onboard-autostart.desktop \
    "${pkgdir}/etc/xdg/autostart/onboard-autostart.desktop"

  # User access to /dev/uinput is distribution policy. Keep the rule available
  # to administrators, but do not silently install a security-sensitive rule.
  install -Dm644 data/72-onboard-uinput.rules \
    "${pkgdir}/usr/share/${pkgname}/72-${pkgname}-uinput.rules"
}
